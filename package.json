{
  "name": "voltrus-explorers",
  "private": true,
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev:bacnet": "bun --filter bacnet-explorer tauri dev",
    "dev:modbus": "bun --filter modbus-poll tauri dev",
    "dev:dnp3": "bun --filter dnp3-explorer tauri dev",
    "dev:s7": "bun --filter s7-explorer tauri dev",
    "dev:ble": "bun --filter ble-inspector tauri dev",
    "dev:enip": "bun --filter enip-explorer tauri dev",
    "dev:serial": "bun --filter serial-monitor tauri dev",
    "dev:nats": "bun --filter nats-explorer tauri dev",
    "dev:mqtt": "bun --filter mqtt-explorer tauri dev",
    "dev:opcua": "bun --filter opcua-explorer tauri dev"
  },
  "devDependencies": {
    "puppeteer-core": "^25.15.0"
  }
}
