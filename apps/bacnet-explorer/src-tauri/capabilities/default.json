{
  "identifier": "default",
  "description": "Default capabilities for BACnet Explorer (desktop)",
  "windows": [
    "main",
    "device-panel"
  ],
  "platforms": [
    "macOS",
    "windows",
    "linux"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-size",
    "core:window:allow-center",
    "core:window:allow-close",
    "core:event:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file"
  ]
}
