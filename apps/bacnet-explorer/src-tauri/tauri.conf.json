{
  "$schema": "https://raw.githubusercontent.com/nicehash/Tauri/canary/tooling/cli/schema.json",
  "productName": "BACnet Explorer",
  "version": "1.1.0",
  "identifier": "com.joyodigitama.bacnet-explorer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "BACnet Explorer",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 13
        },
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "copyright": "Copyright 2026 JoyoDigitama. Licensed under GPL-3.0-or-later.",
    "shortDescription": "BACnet/IP device explorer and monitor",
    "longDescription": "Discover, monitor, and control BACnet/IP building automation devices. Browse objects, read and write properties, and inspect real-time values across BACnet networks.",
    "macOS": {
      "entitlements": "entitlements.plist",
      "providerShortName": "JoyoDigitama",
      "minimumSystemVersion": "13.0"
    }
  }
}
