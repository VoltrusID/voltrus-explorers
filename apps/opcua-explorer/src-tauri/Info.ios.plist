<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged into gen/apple/<app>_iOS/Info.plist by Tauri (Info.ios.plist next to
	     tauri.conf.json is picked up automatically). Connecting to OPC UA servers (opc.tcp), server discovery and the built-in OPC UA server use the local network. OPC UA does not use Bonjour here, so no NSBonjourServices. -->
	<!-- productName must stay space-free for the Xcode 26 archive step, so the
	     home-screen name comes from CFBundleDisplayName instead. -->
	<key>CFBundleDisplayName</key>
	<string>OPC UA Explorer</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>OPC UA Explorer connects to OPC UA servers on your local network: it finds them, browses their address space, reads, writes and subscribes to node values, and can run a virtual OPC UA server that other OPC UA clients can connect to.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
