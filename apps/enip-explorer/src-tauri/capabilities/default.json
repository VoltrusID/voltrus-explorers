{
  "identifier": "default",
  "description": "Default capabilities for EtherNet/IP Explorer",
  "windows": [
    "main",
    "device-panel"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-size",
    "core:window:allow-center",
    "core:window:allow-close",
    "core:event:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file"
  ]
}
