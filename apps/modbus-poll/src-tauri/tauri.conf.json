{
  "$schema": "https://raw.githubusercontent.com/nicehash/Tauri/canary/tooling/cli/schema.json",
  "productName": "Modbus Poll",
  "version": "1.3.7",
  "identifier": "com.joyodigitama.modbus-poll",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "Modbus Poll",
        "width": 960,
        "height": 640,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 13
        },
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["voltrus-modbus-poll"] },
      "mobile": [{ "scheme": ["voltrus-modbus-poll"] }]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "copyright": "Copyright 2026 JoyoDigitama. Licensed under GPL-3.0-or-later.",
    "shortDescription": "Modbus TCP/RTU master and slave simulator",
    "longDescription": "Read, write, and simulate Modbus devices over TCP and RTU serial. Master mode connects to Modbus devices to poll registers. Slave mode runs a Modbus server to simulate devices. Supports FC03/FC06/FC16, bulk reads, and CSV log export.",
    "macOS": {
      "entitlements": "entitlements.plist",
      "providerShortName": "JoyoDigitama",
      "minimumSystemVersion": "13.0"
    },
    "iOS": {
      "developmentTeam": "F6Q6UFUK69",
      "minimumSystemVersion": "15.0"
    }
  }
}
