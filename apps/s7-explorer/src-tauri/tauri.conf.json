{
  "$schema": "https://raw.githubusercontent.com/nicehash/Tauri/canary/tooling/cli/schema.json",
  "productName": "S7 Explorer",
  "version": "1.4.0",
  "identifier": "com.joyodigitama.s7-explorer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "S7 Explorer",
        "width": 1280,
        "height": 820,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 13
        },
        "acceptFirstMouse": true,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "copyright": "Copyright 2026 JoyoDigitama. Licensed under GPL-3.0-or-later.",
    "shortDescription": "S7 PLC tag reader and simulator",
    "longDescription": "Connect to S7-compatible PLCs (S7-300, S7-400, S7-1200 and S7-1500) over Ethernet. Read data blocks and memory areas, monitor tag values, write values, view trends and inspect diagnostics. Not affiliated with or endorsed by Siemens.",
    "macOS": {
      "entitlements": "entitlements.plist",
      "providerShortName": "JoyoDigitama",
      "minimumSystemVersion": "13.0"
    },
    "iOS": {
      "developmentTeam": "F6Q6UFUK69",
      "minimumSystemVersion": "15.0"
    }
  }
}
