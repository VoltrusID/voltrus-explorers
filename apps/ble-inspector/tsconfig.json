{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"],
  // Vitest runs the repo-wide entitlements check, which reads files through node:fs; tsc does not need to see it.
  "exclude": ["src/__tests__/entitlements.test.ts"]
}
